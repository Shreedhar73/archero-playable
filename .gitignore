node_modules/
dist/
.DS_Store
requirements/
shots/

# Archer pipeline. The Mixamo downloads are tens of MB each (the Pro Longbow
# Pack alone is 39 MB, the merged raw glb 45 MB) and everything fbx-merge.mjs
# writes is regenerated from them; assets/*.glb is the output that actually
# ships and stays committed.
assets/raw/*.fbx
assets/raw/Pro Longbow Pack/
assets/raw/erika-final-raw.glb
assets/raw/erika-textures/

# The hero pipeline's intermediates: `archero-base.glb` is the Sketchfab
# download with its material converted and its bones renamed, and
# `archero-final-raw.glb` is that plus the clips and the bow. Both are
# regenerated by `npm run archero` from `archero-model.glb` and `bow.glb`,
# which do stay committed.
assets/raw/archero-base.glb
assets/raw/archero-final-raw.glb

# The CC0 recordings the second audio pass used. Nothing in the build reads
# them any more — sound is synthesized (src/audio/synth.ts) — but they are
# what a sampled version would start from again.
assets/raw/audio/
